export NH_FILE=$(expand_path ./nixos.nix)
export NH_ATTRP=${HOSTNAME}
export NH_SHOW_ACTIVATION_LOGS=true

watch_file wrappers.nix
watch_file npins/sources.json
shopt -s nullglob
for f in "wrappers/*"; do
    if [ "${f##*/}" = "glide-browser" ]; then continue; fi
    if [ -d "$f" ]; then
        watch_dir $f
    elif [ -f "$f" ]; then
        watch_file $f
    fi
done

nix_direnv_manual_reload
use nix -A default
