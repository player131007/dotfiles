set-face global Default "rgb:ffffff,rgb:161616"
set-face global PrimarySelection "rgb:e0e0e0,rgb:393939"
set-face global SecondarySelection PrimarySelection
set-face global PrimaryCursor "rgb:161616,rgb:b2a355"
set-face global SecondaryCursor "rgb:e0e0e0,rgb:8d8d8d"
set-face global PrimaryCursorEol "rgb:161616,rgb:78a9ff+f"
set-face global SecondaryCursorEol "rgb:161616,rgb:8d8d8d+f"
set-face global MenuForeground "rgb:a6c8ff,rgb:343a3f+b"
set-face global MenuBackground "rgb:ffffff,rgb:21272a"
set-face global MenuInfo "rgb:161616,rgb:08bdba"
set-face global Information "rgb:161616,rgb:08bdba"
set-face global InlineInformation Information
set-face global Error "rgb:ffffff,rgb:a2191f"
set-face global DiagnosticError ",default,rgb:fa4d56+c"
set-face global DiagnosticWarning ",default,rgb:ffe97b+c"
set-face global StatusLine "rgb:ffffff"
set-face global StatusLineMode "rgb:33b1ff"
set-face global StatusLineInfo "rgb:be95ff"
set-face global StatusLineValue "rgb:ff7eb6+b"
set-face global Prompt "rgb:be95ff+b"
set-face global StatusCursor PrimaryCursor
set-face global BufferPadding "rgb:4d5358"
set-face global LineNumbers "rgb:a8a8a8"
set-face global LineNumberCursor "rgb:f7f3f2,rgb:4d5358+b"
set-face global LineNumbersWrapped "rgb:a8a8a8,rgb:393939"
set-face global MatchingChar ",rgb:003a6d+bu"
set-face global Whitespace "rgb:525252+f"
set-face global WrapMarker "rgb:726e6e"

set-face global value "rgb:82cfff+b"
set-face global type "rgb:78a9ff"
set-face global variable "rgb:c1c7cd"
set-face global module "rgb:78a9ff"
set-face global function "rgb:ff7eb6"
set-face global string "rgb:42be65"
set-face global keyword "rgb:78a9ff"
set-face global operator "rgb:78a9ff"
set-face global attribute "rgb:3ddbd9"
set-face global comment "rgb:8d8d8d+i"
set-face global documentation "rgb:8d8d8d"
set-face global meta "rgb:be95ff"
set-face global builtin "rgb:08bdba+b"

set-face global title "rgb:4589ff+b"
set-face global header "rgb:78a9ff"
set-face global mono "rgb:3ddbd9"
set-face global block mono
set-face global link "rgb:be95ff+u"
set-face global bullet "rgb:08bdba"
set-face global list bullet
